# Optional — overrides the API/WebSocket origin the Axios client and
# WebSocket hook talk to. Empty means same-origin (Vite dev server proxies
# /api, /health, /ws to :8000 — see vite.config.ts). Only set these if the
# frontend is served from a different origin than the backend.
VITE_API_BASE_URL=
VITE_WS_URL=

# Optional — attaches an X-API-Key header to every request (approve/reject
# decision, v2 goal/approval, simulation start/stop, crawl, and all reads).
# Only needed if the backend has API_KEY configured; leave unset to send no
# header at all, matching the backend's no-op-when-unconfigured behavior.
VITE_API_KEY=
